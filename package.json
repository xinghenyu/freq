{
  "name": "@djiji/freq",
  "version": "1.0.0",
  "description": "Zero-dependency TypeScript HTTP client built on native fetch, with retry, hooks and SSE.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup src/index.ts --format esm --minify --clean && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "keywords": [
    "http",
    "fetch",
    "client",
    "sse",
    "typescript"
  ],
  "author": "djiji",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
